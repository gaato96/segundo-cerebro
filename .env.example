# ============================================================
# Segundo Cerebro — variables de entorno
#
# Local:  copiá este archivo a .env.local y completá los valores.
# Vercel: cargá las mismas en Settings > Environment Variables
#         (Production, Preview y Development) y volvé a deployar:
#         las variables NO se aplican al deploy que ya está online.
# ============================================================

# ---------- Supabase (obligatorio) ----------
# Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role: SALTEA RLS. Solo servidor, nunca con prefijo NEXT_PUBLIC_.
# La usa el cron de notificaciones para leer los datos sin sesión de usuario.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- IA (obligatorio para el copiloto) ----------
# Sin al menos una de estas dos, todo lo que diga "que lo proponga el coach",
# la revisión semanal y el procesado del inbox fallan.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: forzar un modelo. Si no, se prueba la cadena por defecto.
# GEMINI_MODEL=gemini-3.8-flash

# Groq: https://console.groq.com/keys — se usa como respaldo si Gemini falla.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ---------- Notificaciones push (opcional) ----------
# Generá el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com

# Protege /api/notifications/cron. Poné cualquier string largo al azar.
# Vercel Cron manda este valor como Bearer token.
CRON_SECRET=

# ---------- Extras (opcional) ----------
# TMDB, para buscar películas y series en el módulo Media.
NEXT_PUBLIC_TMDB_API_KEY=

# Habilita /api/admin-reset. Dejala vacía si no la vas a usar.
ADMIN_RESET_SECRET=
